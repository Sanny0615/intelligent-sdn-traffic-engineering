# Environment Configuration
APP_ENV=development
APP_NAME=intelligent-sdn-traffic-engineering
LOG_LEVEL=INFO

# API Configuration
HOST=127.0.0.1
PORT=8000

# Optional LLM Provider Configuration (Groq / Ollama)
# If left blank, the application automatically uses the built-in local RAG context synthesis fallback.
GROQ_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
